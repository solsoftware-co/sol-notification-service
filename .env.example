# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.

# App server port (default: 3000)
PORT=3000

# Vercel deployment environment: development | preview | production
# Set automatically by Vercel in deployed environments.
VERCEL_ENV=development

# Email sending mode: mock (log only) | test (real send, [TEST: ...] subject prefix) | live (real send)
# development → mock, preview → test, production → live
EMAIL_MODE=mock

# Inngest event key — not required for local dev (Dev Server handles auth)
# Get from https://app.inngest.com → Your App → Event Keys
INNGEST_EVENT_KEY=

# Inngest signing key — not required for local dev
# Get from https://app.inngest.com → Your App → Signing Keys
INNGEST_SIGNING_KEY=

# sol-api base URL and API key — client + notification-log data now lives
# behind sol-api, not a direct DB connection. Point at the deployment
# matching this app's own environment (dev -> sol-api dev, preview -> staging,
# production -> production).
SOL_API_URL=
SOL_API_KEY=

# Resend email provider API key
# Get from https://resend.com/api-keys
RESEND_API_KEY=

# Anthropic Claude API key (for AI-assisted workflows)
# Get from https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── E2E Email Testing (feature 010) ────────────────────────────────────────
# Required for running `npm run test:e2e` against a Preview deployment.
# See specs/010-e2e-email-ci/quickstart.md for setup instructions.

# Vercel Preview deployment URL to test against
PREVIEW_URL=

# Inngest staging environment keys (separate from production)
INNGEST_EVENT_KEY_STAGING=
INNGEST_SIGNING_KEY_STAGING=

# Mailtrap sandbox credentials — https://mailtrap.io → Email Testing → Inboxes
# SMTP credentials: inbox → Integrations tab → Nodemailer (user/pass)
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# API credentials: account → API Tokens (for e2e test suite to read captured emails)
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_INBOX_ID=
